# ai-intelligence-apps — 環境変数の雛形。`cp .env.example .env` して使う。

# アプリ
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=*

# データベース（--with-db で生成した場合のみ使う）
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=password
DB_NAME=ai_intelligence

#ここから
# データベース（手元は SQLite / Docker 不要。PostgreSQL へ切り替える場合は postgresql）
DB_BACKEND=sqlite
SQLITE_PATH=var/ai_intelligence.db

# AI（Claude API）— crawl / filter が利用する
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5

# 成果物ストレージ（config.json / 中間xlsx / 生成HTML はファイルが正）
ARTIFACT_ROOT=artifacts
HISTORY_MAX_GENERATIONS=10
SCRATCH_TTL_HOURS=24

# タイムゾーン（Asia/Tokyo 基準、ISO週は月曜始まり）
TIMEZONE=Asia/Tokyo

# --- AI 呼び出し（Claude Code CLI。T-15 / TASKS.md §1.1「AI呼び出し方式」）---
# 認証は会社の Team 契約でログイン済みの CLI セッション。APIキーは使わない
# （実装は子プロセスの環境から ANTHROPIC_API_KEY を除いて渡す）。
# ANTHROPIC_API_KEY は本番（AWS 展開）で Anthropic API 実装へ切り替えるとき用に残置。
AI_CLI_COMMAND=claude

# ⚠️ 既定を短くしないこと。1+1 のような些細なプロンプトでも約131秒かかる実測がある
#    （CLI の起動・初期化のオーバーヘッド）。crawl は呼び出し側が下段を渡す。
AI_TIMEOUT_SECONDS=600
AI_CRAWL_TIMEOUT_SECONDS=1800

# 構造化出力の担保（JSON のみ出力を指示 → Pydantic で検証 → 不一致は再依頼）。
# リトライ対象はスキーマ不一致だけ。1回あたり数分かかるので上限は控えめに。
AI_MAX_ATTEMPTS=3
AI_RETRY_BACKOFF_SECONDS=2.0